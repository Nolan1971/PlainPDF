#include <windows.h>
#include "Resource.h"

1 VERSIONINFO
	FILEVERSION 1,0,0,0
	PRODUCTVERSION 1,0,0,0
	FILEOS VOS_NT_WINDOWS32
	FILETYPE VFT_APP
	BEGIN
		BLOCK "StringFileInfo"
		BEGIN
			BLOCK "040904b0"
			BEGIN
				VALUE "CompanyName", "Nolan White"
				VALUE "FileDescription", "PlainPDF"
				VALUE "FileVersion", "1.0.0"
				VALUE "LegalCopyright", "Copyright (c) 2026 Nolan White"
				VALUE "OriginalFilename", "PlainPDF.exe"
				VALUE "ProductName", "PlainPDF"
				VALUE "ProductVersion", "1.0.0"
			END
		END
		BLOCK "VarFileInfo"
		BEGIN
			VALUE "Translation", 0x409, 1200
		END
	END

ID_MAIN_MENU MENU
BEGIN
	POPUP "&File"
	BEGIN
		MENUITEM "&Open...\tCtrl+O", ID_OPEN
		MENUITEM "&Close\tCtrl+W", ID_CLOSE
		POPUP "&Recent Files"
		BEGIN
			MENUITEM "&Clear Recent Files", ID_CLEAR_RECENT
		END
		MENUITEM SEPARATOR
		MENUITEM "&Print...\tCtrl+P", ID_PRINT
		MENUITEM SEPARATOR
		MENUITEM "E&xit\tAlt+F4", ID_EXIT
	END
	POPUP "&Edit"
	BEGIN
		MENUITEM "&Copy\tCtrl+C", ID_COPY
		MENUITEM "&Find\tCtrl+F", ID_FIND
		MENUITEM "Find &Next\tF3", ID_FIND_NEXT
		MENUITEM "Find &Previous\tShift+F3", ID_FIND_PREVIOUS
	END
	POPUP "&View"
	BEGIN
		MENUITEM "&Sidebar\tF4", ID_SIDEBAR
		MENUITEM SEPARATOR
		MENUITEM "Fit &Page\tCtrl+0", ID_FIT_PAGE
		MENUITEM "&Actual Size\tCtrl+1", ID_ACTUAL_SIZE
		MENUITEM "Fit &Width\tCtrl+2", ID_FIT_WIDTH
		MENUITEM "Zoom &In\tCtrl++", ID_ZOOM_IN
		MENUITEM "Zoom &Out\tCtrl+-", ID_ZOOM_OUT
	END
	POPUP "&Help"
	BEGIN
		MENUITEM "&About PlainPDF", ID_ABOUT
	END
END

ID_ACCELERATORS ACCELERATORS
BEGIN
	"O", ID_OPEN, VIRTKEY, CONTROL
	"W", ID_CLOSE, VIRTKEY, CONTROL
	"P", ID_PRINT, VIRTKEY, CONTROL
	"C", ID_COPY, VIRTKEY, CONTROL
	"F", ID_FIND, VIRTKEY, CONTROL
	VK_F3, ID_FIND_NEXT, VIRTKEY
	VK_F3, ID_FIND_PREVIOUS, VIRTKEY, SHIFT
	VK_F4, ID_SIDEBAR, VIRTKEY
	"0", ID_FIT_PAGE, VIRTKEY, CONTROL
	"1", ID_ACTUAL_SIZE, VIRTKEY, CONTROL
	"2", ID_FIT_WIDTH, VIRTKEY, CONTROL
	VK_ADD, ID_ZOOM_IN, VIRTKEY, CONTROL
	VK_SUBTRACT, ID_ZOOM_OUT, VIRTKEY, CONTROL
	VK_OEM_PLUS, ID_ZOOM_IN, VIRTKEY, CONTROL
	VK_OEM_MINUS, ID_ZOOM_OUT, VIRTKEY, CONTROL
END

ID_PASSWORD_DIALOG DIALOGEX 0, 0, 220, 79
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "PlainPDF - PDF password"
FONT 9, "Segoe UI"
BEGIN
	LTEXT "Enter the PDF password.", ID_PASSWORD_PROMPT, 10, 9, 200, 14
	EDITTEXT ID_PASSWORD_EDIT, 10, 27, 200, 14, ES_PASSWORD | ES_AUTOHSCROLL
	DEFPUSHBUTTON "OK", IDOK, 105, 55, 50, 14
	PUSHBUTTON "Cancel", IDCANCEL, 160, 55, 50, 14
END

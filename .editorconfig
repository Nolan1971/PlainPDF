# PlainPDF: tabs, 4-column display, line-ending discipline.
# Allman braces and the other semantic style rules are in PlainPDF_Coding_Style.md.
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,cc,cpp,cxx,h,hpp,rc}]
indent_style = tab
indent_size = 4
tab_width = 4
end_of_line = crlf

[*.{md,txt,yml,yaml,json}]
indent_style = space
indent_size = 2
end_of_line = lf

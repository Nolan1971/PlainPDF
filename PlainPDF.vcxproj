    <UseDebugLibraries Condition="'$(Configuration)' == 'Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)' == 'Release'">false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <Architecture Condition="'$(Platform)' == 'Win32'">x86</Architecture>
    <Architecture Condition="'$(Platform)' == 'x64'">x64</Architecture>
    <Architecture Condition="'$(Platform)' == 'ARM64'">arm64</Architecture>
    <OutDir>$(MSBuildProjectDirectory)\out\build\$(Architecture)\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildProjectDirectory)\out\obj\$(Architecture)\$(Configuration)\</IntDir>
    <PdfiumDir>$(MSBuildProjectDirectory)\out\pdfium\$(Architecture)\</PdfiumDir>
  </PropertyGroup>
  <ItemDefinitionGroup>

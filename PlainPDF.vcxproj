  </Target>
  <Target Name="CopyPdfium" AfterTargets="Build">
    <Copy SourceFiles="$(PdfiumDir)bin\pdfium.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
